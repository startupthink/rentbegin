# ===================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env ขึ้น git)
#   cp .env.example .env
#
# หาได้จาก Supabase Dashboard → Project Settings → API
# ===================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ค่านี้ใส่เฉพาะฝั่ง Supabase Edge Function (สำหรับ LINE Login)
# อย่าใส่ไว้ในไฟล์ frontend เพราะเป็นความลับ
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
